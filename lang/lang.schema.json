{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shell4 language",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "you know this.",
      "format": "uri"
    },
    "init.welcome": {
      "type": "string",
      "minLength": 1,
      "description": "Welcome message"
    },
    "cmd.help.title": {
      "type": "string",
      "minLength": 1,
      "description": "Title in help command"

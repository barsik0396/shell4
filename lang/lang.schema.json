  "required": [
    "init.welcome", "main.prompt", "cmd.help.title", "cmd.help.help",
    "cmd.help.exit", "cmd.help.version", "cmd.help.bin",
    "cmd.help.platform", "cmd.help.crash", "cmd.help.cd",

    "cmd.help.help": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'help'"
    },
    "cmd.help.exit": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'exit'"
    },
    "cmd.help.version": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'version'"
    },
    "cmd.help.bin": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'bin'"
    },
    "cmd.help.platform": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'platform'"
    },
    "cmd.help.crash": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'crash'"
    },
    "cmd.help.cd": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'cd'"
    },
    "cmd.help.touch": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'touch'"
    },
    "cmd.help.rm": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'rm'"
    },
    "cmd.help.read": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'read'"
    },
    "cmd.help.where": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'where'"
    },
    "cmd.help.write": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'write'"
    },
    "cmd.help.write-append": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'write-append'"
    },
    "cmd.help.files": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'files'"
    },
    "cmd.help.dir": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'dir'"
    },
    "cmd.help.deldir": {
      "type": "string",
      "minLength": 1,
      "description": "Help text for 'deldir'"
    },
    "cmd.version": {
